# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# הכתובת הציבורית של האתר (ל-OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — התראות מייל ליזמים + דייג'סט שבועי (אופציונלי)
RESEND_API_KEY=
RESEND_FROM=HELIX STAGE <onboarding@resend.dev>

# דייג'סט שבועי (route /api/digest, נקרא ע"י Vercel Cron)
SUPABASE_SERVICE_ROLE_KEY=
DIGEST_SECRET=

# Content Agent — יצירת תוכן per-ערוץ עם Claude
ANTHROPIC_API_KEY=
CONTENT_MODEL=claude-sonnet-5

# Engagement — גשר לאקסטנשן (מסלול אפור: תגובות בפייסבוק/אינסטגרם/לינקדאין)
# מפתח משותף בין helix-ops לתוסף PLUG. חייב להיות זהה לערך שמוזן בהגדרות התוסף.
# משמש גם ל-/api/radar/ingest ו-/api/performance.
EXTENSION_SECRET=

# Meta webhook — אימות webhook לתגובות/Comment-to-DM/מענה-הודעות (Messenger/IG)
META_VERIFY_TOKEN=

# ייצוא מדדים ל-HELIX DASHBOARDS (connector helix_ops)
EXPORT_SECRET=
